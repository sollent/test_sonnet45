# Production Environment Configuration

# API Configuration
# VITE_API_BASE_URL задается через Docker build ARG/ENV
# По умолчанию: http://localhost:80 (production backend)
VITE_API_TIMEOUT=10000

# Build Optimization
VITE_SOURCEMAP=false
VITE_DROP_CONSOLE=true

# Features (можно отключить ненужные фичи в production)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
