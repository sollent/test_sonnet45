# Frontend Docker Environment Variables - Example Template
# Copy this file to .env.docker for development or .env.docker.prod for production
# These variables are used inside Docker containers

# ============================================
# API Configuration
# ============================================

# Backend API Base URL
# Development: http://localhost:8089 (backend nginx через docker-compose)
# Production: https://api.production.com (реальный production API)
VITE_API_BASE_URL=http://localhost:8089

# API Request Timeout (milliseconds)
VITE_API_TIMEOUT=5000

# ============================================
# Feature Flags
# ============================================

# Enable Google Analytics
VITE_ENABLE_ANALYTICS=false

# Enable Debug Mode (console logs, dev tools)
VITE_ENABLE_DEBUG=true

# ============================================
# Build Optimization (для production)
# ============================================

# Generate sourcemaps (true для staging, false для production)
VITE_SOURCEMAP=false

# Remove console.log in production
VITE_DROP_CONSOLE=true

# ============================================
# CDN Configuration (опционально)
# ============================================

# CDN URL для статических ресурсов
# VITE_CDN_URL=https://cdn.production.com
