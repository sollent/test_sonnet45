# Symfony Environment Configuration - Example Template
# Copy this file to .env.local and customize for your environment
# NEVER commit .env.local or real credentials to git!

###> symfony/framework-bundle ###
# Application environment: dev, prod, test
APP_ENV=dev

# Random secret string for security features
# Generate: php bin/console secrets:generate-keys
APP_SECRET=CHANGE_ME_TO_RANDOM_STRING

# Enable debug mode (true for dev, false for prod)
APP_DEBUG=true
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Database connection string - uses environment variables from docker-compose
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?serverVersion=VERSION&charset=utf8
# Variables POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB are injected by Docker
# For Docker: Use container name as HOST (psql16)
# For local: Use localhost with exposed port
DATABASE_URL="postgresql://${POSTGRES_USER:-user}:${POSTGRES_PASSWORD:-password}@psql16:5432/${POSTGRES_DB:-backend-app}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# CORS allowed origins regex pattern
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
# JWT key paths (relative to project root)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# JWT passphrase (used to encrypt private key)
# Generate: openssl rand -hex 32
JWT_PASSPHRASE=CHANGE_ME_TO_RANDOM_STRING
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
# JWT refresh token TTL in seconds (default: 30 days)
JWT_REFRESH_TOKEN_TTL=2592000

# Update refresh token on use
JWT_REFRESH_TOKEN_TTL_UPDATE=true
###< gesdinet/jwt-refresh-token-bundle ###

###> symfony/messenger ###
# Message broker connection string
# Format: amqp://USER:PASSWORD@HOST:PORT/%2f/QUEUE_NAME
# For Docker: Use container name as HOST (rabbitmq)
MESSENGER_TRANSPORT_DSN=amqp://user:password@rabbitmq:5672/%2f/messages
# Alternative transports:
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> google/apiclient ###
# Google OAuth2 credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Google OAuth2 redirect URI (optional, auto-configured)
#GOOGLE_REDIRECT_URI=http://localhost:8000/connect/google/check
###< google/apiclient ###
