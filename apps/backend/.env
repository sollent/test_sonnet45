###> centrifugo ###
# Centrifugo WebSocket - Development configuration
# При запуске через Docker переменные приходят из .env.docker
CENTRIFUGO_ENABLED=true
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=${CENTRIFUGO_API_KEY:-dev_api_key_change_in_production}
CENTRIFUGO_HMAC_SECRET=${CENTRIFUGO_HMAC_SECRET:-dev_hmac_secret_change_in_production}
CENTRIFUGO_TOKEN_TTL=3600
###< centrifugo ###