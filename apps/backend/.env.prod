# Symfony Environment Configuration - Production
# Override these values with environment variables in production!
# NEVER commit real production credentials to git!
#
# ⚠️ FAIL-FAST ПРИНЦИП: Все credentials БЕЗ fallback!
# Если переменная не задана, приложение упадет с ошибкой при запуске.
# Это предотвращает запуск production с дефолтными/небезопасными credentials.

###> symfony/framework-bundle ###
APP_ENV=prod
# БЕЗ fallback - MUST be set via environment variable!
APP_SECRET=${APP_SECRET}
APP_DEBUG=false
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Production database - БЕЗ fallback (Fail-Fast принцип!)
# MUST be set via .env.docker.prod or CI/CD environment variables
# Если credentials отсутствуют, Symfony НЕ сможет подключиться к БД
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@psql16:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Production CORS (update with actual domain)
CORS_ALLOW_ORIGIN='^https://yourdomain\.com$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# БЕЗ fallback - MUST be set via environment variable!
JWT_PASSPHRASE=${JWT_PASSPHRASE}
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
JWT_REFRESH_TOKEN_TTL=2592000
JWT_REFRESH_TOKEN_TTL_UPDATE=true
###< gesdinet/jwt-refresh-token-bundle ###

###> symfony/messenger ###
# Production RabbitMQ - БЕЗ fallback (Fail-Fast принцип!)
# MUST be set via .env.docker.prod or CI/CD environment variables
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> google/apiclient ###
# Google OAuth2 - БЕЗ fallback (Fail-Fast принцип!)
# MUST be set via environment variables in production!
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
###< google/apiclient ###
