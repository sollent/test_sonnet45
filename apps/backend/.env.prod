# Symfony Environment Configuration - Production
# Override these values with environment variables in production!
# NEVER commit real production credentials to git!

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_IN_PRODUCTION
APP_DEBUG=false
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Production database - uses environment variables from docker-compose
# MUST override POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB in production!
# Set via .env.docker.prod or CI/CD environment variables
DATABASE_URL="postgresql://${POSTGRES_USER:-prod_user}:${POSTGRES_PASSWORD:-CHANGE_ME}@psql16:5432/${POSTGRES_DB:-backend_prod}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Production CORS (update with actual domain)
CORS_ALLOW_ORIGIN='^https://yourdomain\.com$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# MUST be changed in production!
JWT_PASSPHRASE=CHANGE_ME_IN_PRODUCTION
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
JWT_REFRESH_TOKEN_TTL=2592000
JWT_REFRESH_TOKEN_TTL_UPDATE=true
###< gesdinet/jwt-refresh-token-bundle ###

###> symfony/messenger ###
# Production RabbitMQ (must be overridden in production)
MESSENGER_TRANSPORT_DSN=amqp://prod_user:CHANGE_ME@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> google/apiclient ###
# Google OAuth2 - Production credentials (must be overridden!)
GOOGLE_CLIENT_ID=YOUR_PRODUCTION_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_PRODUCTION_CLIENT_SECRET
###< google/apiclient ###
