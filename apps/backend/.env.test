# Symfony Environment Configuration - Testing
# Used for automated tests and CI/CD

KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

###> symfony/framework-bundle ###
APP_ENV=test
APP_SECRET=test_secret_for_ci_cd_only
APP_DEBUG=false
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Test database (matches .env.docker.test)
DATABASE_URL="postgresql://test_user:test_password@psql16:5432/backend_test?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=test_passphrase_for_ci_cd_only
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
JWT_REFRESH_TOKEN_TTL=2592000
JWT_REFRESH_TOKEN_TTL_UPDATE=true
###< gesdinet/jwt-refresh-token-bundle ###

###> symfony/messenger ###
# Test RabbitMQ (matches .env.docker.test)
MESSENGER_TRANSPORT_DSN=amqp://test_user:test_password@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> google/apiclient ###
# Google OAuth2 - Test/Mock credentials
GOOGLE_CLIENT_ID=test_client_id
GOOGLE_CLIENT_SECRET=test_client_secret
###< google/apiclient ###