# Symfony Environment Configuration - Testing
# Used for automated tests and CI/CD

KERNEL_CLASS='App\Kernel'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

###> symfony/framework-bundle ###
APP_ENV=test
APP_SECRET=test_secret_for_ci_cd_only
APP_DEBUG=false
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Test database - uses environment variables from docker-compose.test.yml
# Host is 'test-psql16' (service name from docker-compose.test.yml)
DATABASE_URL="postgresql://${POSTGRES_USER:-test_user}:${POSTGRES_PASSWORD:-test_password}@test-psql16:5432/${POSTGRES_DB:-backend_test}?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=test_passphrase_for_ci_cd_only
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
JWT_REFRESH_TOKEN_TTL=2592000
JWT_REFRESH_TOKEN_TTL_UPDATE=true
###< gesdinet/jwt-refresh-token-bundle ###

###> symfony/messenger ###
# Test RabbitMQ - uses environment variables from docker-compose.test.yml
# Host is 'test-rabbitmq' (service name from docker-compose.test.yml)
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER:-test_user}:${RABBITMQ_PASSWORD:-test_password}@test-rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> google/apiclient ###
# Google OAuth2 - Test/Mock credentials
GOOGLE_CLIENT_ID=test_client_id
GOOGLE_CLIENT_SECRET=test_client_secret
###< google/apiclient ###