includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    # Analysis level (0-9, higher is stricter)
    # Level 5 is a good starting point - strict but not overwhelming
    level: 5

    # Paths to analyze
    paths:
        - src
        - tests

    # Exclude paths
    excludePaths:
        - src/Kernel.php
        - tests/bootstrap.php

    # Symfony-specific configuration
    symfony:
        # Path to the container XML file
        container_xml_path: var/cache/dev/App_KernelDevDebugContainer.xml
        # Console application loader
        console_application_loader: tests/console-application.php

    # Doctrine-specific configuration
    doctrine:
        # Path to the entity manager
        repositoryClass: App\Repository\BaseRepository
        # Object manager loader
        objectManagerLoader: tests/object-manager.php

    # Type checking configuration
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    checkMissingCallableSignature: false

    # Ignore errors - use sparingly, prefer to fix the code
    ignoreErrors:
        # Common Symfony/Doctrine patterns that PHPStan can't understand
        -
            message: '#Call to an undefined method Doctrine\\ORM\\EntityRepository::#'
            path: src/Repository/*
        -
            message: '#Cannot call method .* on Symfony\\Component\\Security\\Core\\User\\UserInterface\|null#'
            path: src/Controller/*
        # Ignore missing return types in tests
        -
            message: '#Method .+Test::.+ has no return type specified#'
            path: tests/*

    # Additional checks (optional, can be enabled later)
    strictRules:
        # Check for always true/false conditions
        allRules: false
        # Check for dead code
        booleansInConditions: false
        # Check for unused private properties/methods
        uselessCast: false
        # Check for missing type hints
        disallowedLooseComparison: false

    # Bootstrap file for autoloading
    bootstrapFiles:
        - tests/bootstrap.php

    # Report unmatched ignored errors
    reportUnmatchedIgnoredErrors: true

    # Treat phpDocs as source of truth
    treatPhpDocTypesAsCertain: true

    # Check function name case
    checkFunctionNameCase: true

    # Check too wide return type
    checkTooWideReturnTypesInProtectedAndPublicMethods: false

    # Check internal classes
    checkInternalClassCaseSensitivity: true

    # Memory limit
    memoryLimit: 1G

    # Parallel processing
    parallel:
        # Max number of processes (leave empty for auto-detection)
        maximumNumberOfProcesses: null
        # Min number of jobs per process
        minimumNumberOfJobsPerProcess: 2
