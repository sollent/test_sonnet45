includes:
    - phpstan-baseline.neon

parameters:
    # Analysis level (0-9, higher is stricter)
    # Level 5 is a good starting point - strict but not overwhelming
    level: 5

    # Paths to analyze
    paths:
        - src
        - tests

    # Exclude paths
    excludePaths:
        - src/Kernel.php
        - tests/bootstrap.php

    # Symfony-specific configuration
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: tests/console-application.php

    # Doctrine-specific configuration
    doctrine:
        repositoryClass: App\Repository\BaseRepository
        objectManagerLoader: tests/object-manager.php

    # Ignore errors
    ignoreErrors:
        # PHPUnit mock methods (expects, method, etc.) are not recognized by PHPStan
        -
            message: '#Call to an undefined method .+::(expects|method|with|willReturn|willReturnCallback|willThrowException|getMockBuilder|createMock|disableOriginalConstructor|getMock|setMethods|onlyMethods|addMethods|will|any|once|never|exactly|at|atLeastOnce|returnValue|returnArgument|returnCallback|throwException)\(\)#'
            path: tests/*

    # Bootstrap file for autoloading
    bootstrapFiles:
        - tests/bootstrap.php

    # Report unmatched ignored errors
    reportUnmatchedIgnoredErrors: true

    # Treat phpDocs as source of truth
    treatPhpDocTypesAsCertain: true

    # Check function name case
    checkFunctionNameCase: true

    # Check internal classes
    checkInternalClassCaseSensitivity: true
