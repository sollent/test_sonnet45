# Docker Environment Variables - Example Template
# Copy this file to .env.docker and customize for your environment
# This file serves as documentation for all available variables

# ============================================
# Docker Compose Project Name
# ============================================
# Используется для префикса имен контейнеров
# Main: backend-* (для совместимости с CI/CD и production скриптами)
# Worktree: автоматически генерируется скриптом worktree-create.sh
COMPOSE_PROJECT_NAME=backend

# ============================================
# PostgreSQL Configuration
# ============================================
# Database name for the application
POSTGRES_DB=backend-app

# PostgreSQL user (avoid using 'postgres' superuser in production)
POSTGRES_USER=user

# PostgreSQL password (MUST be changed in production!)
POSTGRES_PASSWORD=password

# PostgreSQL exposed port (host machine)
POSTGRES_PORT=15432

# RabbitMQ Configuration
# RabbitMQ default user
RABBITMQ_USER=user

# RabbitMQ default password (MUST be changed in production!)
RABBITMQ_PASSWORD=password

# RabbitMQ AMQP port (host machine)
RABBITMQ_PORT=5672

# RabbitMQ Management UI port (host machine)
RABBITMQ_MANAGEMENT_PORT=15672

# Nginx Configuration
# Nginx exposed port (host machine)
# Production should use 80/443
NGINX_PORT=8089

# PHP-FPM Configuration
# PHP-FPM exposed port (host machine, for debugging)
PHP_FPM_PORT=9009

# ============================================
# Frontend Configuration
# ============================================

# Frontend Development Port
# Vite dev server port (host machine)
FRONTEND_DEV_PORT=3000

# Frontend Production Port
# Nginx production port (host machine)
FRONTEND_PROD_PORT=8080

# Vite Environment Variables
# API base URL for frontend
# ВАЖНО: В production ОБЯЗАТЕЛЬНО переопределить через .env.docker.prod!
VITE_API_BASE_URL=http://localhost:8089

# ============================================
# AI Services Configuration
# ============================================

# Ollama Configuration (LLM Service)
# Ollama port (host machine)
OLLAMA_PORT=11434

# Модели для автоматической загрузки (через запятую)
# Рекомендуется: qwen2.5:1.5b (оптимальный баланс скорости/качества, ~2-3GB RAM, быстро на CPU!)
# Доступные: qwen2.5:1.5b, qwen2.5:3b, qwen2.5:7b, mistral:7b, llama3.1:8b
OLLAMA_MODELS=qwen2.5:1.5b

# Debug mode для Ollama
OLLAMA_DEBUG=false

# Whisper Configuration (Speech-to-Text Service)
# Whisper service port (host machine)
WHISPER_PORT=9000

# Whisper model size: tiny, base, small, medium, large
# base - рекомендуется для баланса скорости и качества
WHISPER_MODEL=base

# Whisper engine: openai_whisper, faster_whisper
WHISPER_ENGINE=openai_whisper

# Язык для распознавания речи: ru, en, uk
WHISPER_LANGUAGE=ru

# Centrifugo Configuration (WebSocket Service)
# Centrifugo WebSocket port (host machine)
CENTRIFUGO_PORT=8000

# Centrifugo Admin UI port (host machine)
CENTRIFUGO_ADMIN_PORT=8001

# Enable admin panel
CENTRIFUGO_ADMIN=true

# Admin panel password (MUST be changed in production!)
CENTRIFUGO_ADMIN_PASSWORD=admin

# Admin secret key (MUST be changed in production!)
CENTRIFUGO_ADMIN_SECRET=secret

# API key for server-side requests (MUST be changed in production!)
CENTRIFUGO_API_KEY=api-key

# HMAC secret for JWT tokens (MUST be changed in production!)
CENTRIFUGO_SECRET=secret-key

# Allowed origins for CORS (comma-separated)
CENTRIFUGO_ORIGINS=http://localhost:3000,http://localhost:8089

# Redis Configuration (Cache for Centrifugo)
# Redis port (host machine)
REDIS_PORT=6379

# Redis password (leave empty for no password in dev)
REDIS_PASSWORD=
