{
  "v3_use_offset": true,
  "token_hmac_secret_key": "${CENTRIFUGO_TOKEN_HMAC_SECRET_KEY}",
  "api_key": "${CENTRIFUGO_API_KEY}",
  "admin": true,
  "admin_password": "${CENTRIFUGO_ADMIN_PASSWORD}",
  "admin_secret": "${CENTRIFUGO_ADMIN_SECRET}",
  "admin_insecure": false,
  "allowed_origins": ["http://localhost:3000", "http://localhost:3001", "http://localhost:8089", "http://localhost:8090"],
  "allow_subscribe_for_client": false,
  "allow_publish_for_client": false,
  "allow_presence_for_client": false,
  "allow_history_for_client": false,
  "allow_join_leave_for_client": false,
  "presence": true,
  "join_leave": true,
  "force_push_join_leave": true,
  "history_size": 100,
  "history_ttl": "300s",
  "history_recover": true,
  "force_recovery": false,
  "redis_address": "redis:6379",
  "redis_password": "${REDIS_PASSWORD}",
  "redis_db": 0,
  "redis_prefix": "centrifugo",
  "redis_use_lists": false,
  "log_level": "info",
  "log_file": "",
  "node": "centrifugo",
  "engine": "redis",
  "client_insecure": false,
  "client_anonymous": false,
  "client_channel_limit": 128,
  "channel_max_length": 255,
  "user_connection_limit": 10,
  "client_queue_max_size": 10485760,
  "client_concurrency": 0,
  "client_channel_position_check_delay": "1s",
  "client_expired_close_delay": "10s",
  "client_expired_sub_close_delay": "10s",
  "client_stale_close_delay": "10s",
  "client_message_write_timeout": "0s",
  "client_request_max_size": 65536,
  "client_queue_initial_capacity": 2,
  "ping_interval": "25s",
  "pong_timeout": "5s",
  "uni_http_stream": false,
  "namespaces": [
    {
      "name": "user",
      "presence": true,
      "join_leave": true,
      "history_size": 50,
      "history_ttl": "60s",
      "history_recover": true,
      "allow_subscribe_for_client": false,
      "allow_publish_for_client": false
    },
    {
      "name": "global",
      "presence": false,
      "join_leave": false,
      "history_size": 10,
      "history_ttl": "30s",
      "history_recover": false,
      "allow_subscribe_for_client": true,
      "allow_publish_for_client": false
    }
  ]
}