# Redis Configuration for Caching
# Add this to your .env file

###> Redis Cache ###

# For Docker environment (default setup with docker-compose.yml):
# Redis container name is 'redis' on internal Docker network
REDIS_URL=redis://redis:6379

# For local development (if running Redis locally without Docker):
# REDIS_URL=redis://localhost:6379

# For connection from host machine to Docker Redis (port 16379 mapped):
# REDIS_URL=redis://localhost:16379

# Redis with password:
# REDIS_URL=redis://password@redis:6379

# Redis cluster or sentinel:
# REDIS_URL=redis://redis:6379?dbindex=0&timeout=5

###< Redis Cache ###

# Cache TTL Settings (optional - can be overridden in code)
CACHE_TTL_TASKS=300
CACHE_TTL_ANALYTICS=900
CACHE_TTL_USER_DATA=600
